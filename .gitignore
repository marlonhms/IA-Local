# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pyo

# Ambientes virtuais
venv/
.venv/
env/
ENV/

# Configurações e segredos locais (LGPD & Security)
.env
*.env
*.env.*
!.env.example
erp_password.txt
**/erp_password.txt
*password*.txt
*.secret
*.key
*.pem

# Backups e dumps de banco de dados
backups/*
!backups/.gitkeep
*.backup
*.bak
*.dump
*.sql
!scripts/*.sql
*.db
*.sqlite
*.sqlite3
/data/
/data/*

# Logs e arquivos temporários
*.log
*.tmp
*.temp

# Agentes locais e IDEs
.agents/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Android build & caches
.gradle/
.kotlin/
local.properties
**/build/
*.apk
*.aab

# Dumps e textos brutos de desenvolvimento
/bloco hero.txt

# Binarios e servicos locais
bin/*.exe
!bin/.gitkeep
dist/
build/
*.spec.bak


# Android development screenshots
screen_*.png
**/screen_*.png

# Scratch scripts
scratch/
