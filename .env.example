# ==============================================================================
# AURA - CONFIGURACAO DE AMBIENTE (.env)
# ==============================================================================

# Google Gemini API (Obtenha em: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# ==============================================================================
# SEGURANCA CRIPTOGRAFICA DE ACTION VOUCHERS (HMAC-SHA256)
# ==============================================================================
# Chave secreta de 32 bytes hexadecimais para assinatura digital de comprovantes
# Em producao, gere via: python -c "import secrets; print(secrets.token_hex(32))"
AURA_VOUCHER_SECRET=sua_chave_secreta_hmac_32_bytes_aqui

# ==============================================================================
# BANCO ERP TRANSACIONAL (PostgreSQL 16 Windows Service)
# ==============================================================================
# - Executando LOCALMENTE no Notebook: use 'localhost'
# - Executando REMOTAMENTE (Ex: PC de Casa via Tailscale): use o IP Tailscale ou MagicDNS
ERP_DB_HOST=localhost
ERP_DB_PORT=5433
ERP_DB_NAME=posto
ERP_DB_USER=suporte
ERP_DB_PASSWORD=sua_senha_erp_aqui
ERP_DB_CONNECT_TIMEOUT=5

# ==============================================================================
# BANCO VETORIAL SEMANTICO (PostgreSQL 16 Local Windows pgvector)
# ==============================================================================
# - Executando LOCALMENTE no Notebook: use 'localhost'
# - Executando REMOTAMENTE (Ex: PC de Casa via Tailscale): use o IP Tailscale ou MagicDNS
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433
VECTOR_DB_NAME=posto_ai
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=sua_senha_postgres_aqui
VECTOR_DB_CONNECT_TIMEOUT=5

# ==============================================================================
# MODELOS DO GOOGLE GEMINI
# ==============================================================================
DEFAULT_EMBEDDING_MODEL=models/gemini-embedding-001
DEFAULT_LLM_MODEL=models/gemini-3.1-flash-lite

